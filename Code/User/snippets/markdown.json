{
    "File Information": {
        "prefix": "infor",
        "body": [
            "---",
            "Title: $1",
            "Author: $2",
            "Date: $3",
            "Modified: $4",
            "---"
        ]
    },
	"inline code": {
		"prefix": "ic",
		"body": "`$1`",
		"description": "Insert inline code"
	},
    "code block": {
        "prefix": "cb",
        "body": [
            "```$2",
            "$1",
            "```"
        ],
        "description": "Insert code block"
    },
    "inline math": {
        "prefix": "mk",
        "body": "$$1$",
        "description": "Insert inline math"
    },
    "fraction": {
        "prefix": "\\frac",
        "body": "\\frac{$1}{$2}",
        "description": "Insert fraction"
    },

    /* -------------------- Greek -----------------------------*/
    "rho": {
        "prefix": "@r",
        "body": "\\rho",
        "description": "gresk letter rho"
    },
}